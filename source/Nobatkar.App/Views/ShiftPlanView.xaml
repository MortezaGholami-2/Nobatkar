<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Nobatkar.App.Views.ShiftPlanView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Nobatkar.App"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollView>

        <StackPanel Padding="40" Spacing="20" MaxWidth="600">
            
            <TextBlock Text="Set Shift Plan"
                       FontSize="32"
                       FontWeight="SemiBold" />

            <TextBlock Text="Plan Name"
                       FontSize="16" />

            <TextBox Text="{Binding PlanName, Mode=TwoWay}"
                     PlaceholderText="Enter a name for the shift plan." />

            <TextBlock Text="Start date"
                       FontSize="16"
                       Margin="0,8,0,0" />

            <DatePicker Date="{Binding StartDate, Mode=TwoWay}" />

            <TextBlock Text="Add shifts to the pattern"
                       FontSize="16"
                       Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                
                <ComboBox Width="180"
                          ItemsSource="{Binding ShiftTypes}"
                          SelectedItem="{Binding SelectedShift, Mode=TwoWay}" />

                <Button Content="Add Shift"
                        Command="{Binding AddShiftCommand}" />
                
            </StackPanel>

            <TextBlock Text="Current pattern"
                       FontSize="16"
                       Margin="0,8,0,0" />

            <ItemsControl ItemsSource="{Binding Shifts}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,8"
                                Margin="0,0,8,0"
                                CornerRadius="8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <TextBlock Text="{Binding}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                
            </ItemsControl>

            <Button Content="Remove Last Shift"
                    Command="{Binding RemoveLastShiftCommand}"
                    HorizontalAlignment="Left" />
            
            <Button Content="Save Shift Plan"
                    Command="{Binding SaveShiftPlanAsyncCommand}"
                    HorizontalAlignment="Left"
                    Margin="0,16,0,0"/>
            
        </StackPanel>
        
    </ScrollView>

</Page>
